{
  "name": "SocialProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Kopplad anv\u00e4ndar-ID"
    },
    "username": {
      "type": "string",
      "description": "Unikt Anchor-anv\u00e4ndarnamn (t.ex. @alice)"
    },
    "display_name": {
      "type": "string",
      "description": "Visningsnamn i J\u00e4mf\u00f6r"
    },
    "city": {
      "type": "string",
      "description": "Stad f\u00f6r filtrering"
    },
    "bio": {
      "type": "string",
      "description": "Kort bio/status"
    },
    "occupation": {
      "type": "string",
      "description": "Yrke eller studier"
    },
    "age": {
      "type": "integer",
      "description": "\u00c5lder"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Intressen"
    },
    "avatar_style": {
      "type": "object",
      "description": "Avatar-utseende",
      "properties": {
        "skin": {
          "type": "string"
        },
        "hair": {
          "type": "string"
        },
        "hairColor": {
          "type": "string"
        },
        "top": {
          "type": "string"
        },
        "topColor": {
          "type": "string"
        },
        "bg": {
          "type": "string"
        }
      }
    },
    "privacy_level": {
      "type": "string",
      "enum": [
        "full",
        "hybrid",
        "ghost"
      ],
      "default": "hybrid",
      "description": "Niv\u00e5 1=full (kr+%), Niv\u00e5 2=hybrid (%), Niv\u00e5 3=ghost (ingen data)"
    },
    "shared_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Kategorier som delas med v\u00e4nner (tom = alla)"
    },
    "friends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista av v\u00e4n-user_ids"
    },
    "squad_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Squads anv\u00e4ndaren \u00e4r med i"
    },
    "economy_published": {
      "type": "boolean",
      "default": false,
      "description": "Om ekonomin visas i J\u00e4mf\u00f6r"
    },
    "economy_snapshot": {
      "type": "object",
      "description": "Publicerad budget\u00f6gonblicksbild (procent, ev. kronor)",
      "properties": {
        "income": { "type": "number" },
        "savings_rate": { "type": "number" },
        "updated_at": { "type": "string" },
        "budget_template": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "items": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "galaxy_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Taggar f\u00f6r filtrering i J\u00e4mf\u00f6r"
    },
    "avatar_config": {
      "type": "object",
      "description": "Detaljerad avatar (PBREngine)"
    }
  },
  "required": [
    "user_id"
  ]
}